// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  // JS query engine + pg adapter: no native binary to ship to Vercel.
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Room status vocabulary is fixed by the business (see brief) — not a free-form enum in the UI.
enum RoomStatus {
  LUNAS // paid this period
  KOSONG // vacant
  RUSAK // damaged / out of service
  TAHUNAN // pays yearly instead of monthly
  TUNDA_BAYAR // late / unpaid
}

model Room {
  id            String       @id @default(cuid())
  number        Int          @unique // Kamar 1-16
  monthlyRent   Int // Rp per month, room-specific
  status        RoomStatus   @default(KOSONG)
  tenant        Tenant?
  roomIncomes   RoomIncome[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Tenant {
  id           String    @id @default(cuid())
  room         Room      @relation(fields: [roomId], references: [id])
  roomId       String    @unique
  name         String
  phone        String? // WhatsApp-reachable number
  reminderDay  Int? // day of month (1-31) to send the rent reminder
  moveInDate   DateTime?
  leaseEndDate DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// One row per calendar month — the cash-book "sheet".
model CashPeriod {
  id                 String              @id @default(cuid())
  year               Int
  month              Int // 1-12
  openingBalance     Int // Saldo Kas Awal, carried from previous period's closing balance
  roomIncomes        RoomIncome[]
  additionalIncomes  AdditionalIncome[]
  expenses           Expense[]
  transferChecks     TransferCheck[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([year, month])
}

// Pemasukan Sewa Kamar — one row per room per period.
model RoomIncome {
  id           String     @id @default(cuid())
  period       CashPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  periodId     String
  room         Room       @relation(fields: [roomId], references: [id])
  roomId       String
  status       RoomStatus
  amount       Int // Nominal actually received this period (0 if kosong/unpaid)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([periodId, roomId])
}

// Pemasukan Tambahan — ad-hoc extra income line items.
model AdditionalIncome {
  id          String     @id @default(cuid())
  period      CashPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  periodId    String
  description String
  source      String?
  amount      Int
  createdAt   DateTime   @default(now())
}

// Pengeluaran Operasional — categorized expenses.
enum ExpenseCategory {
  LISTRIK
  PDAM
  CLEANING_SERVICE
  KEBERSIHAN
  PERBAIKAN
  INTERNET
  PERLENGKAPAN
  ADMINISTRASI
  PENGURUS
  BAGI_HASIL
  LAINNYA
}

model Expense {
  id          String          @id @default(cuid())
  period      CashPeriod      @relation(fields: [periodId], references: [id], onDelete: Cascade)
  periodId    String
  category    ExpenseCategory
  description String
  amount      Int
  createdAt   DateTime        @default(now())
}

// Configurable list of payout recipients (caretaker, profit-share family members, bank).
model Recipient {
  id             String          @id @default(cuid())
  name           String
  role           String? // e.g. "Pengurus", "Pewaris", "Bank"
  bankName       String? // e.g. "BSI"
  accountNumber  String?
  accountHolder  String? // real name on the bank account
  isActive       Boolean         @default(true)
  transferChecks TransferCheck[]
  createdAt      DateTime        @default(now())
}

// Transfer checklist — did the payout to this recipient actually go out this period.
model TransferCheck {
  id          String     @id @default(cuid())
  period      CashPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  periodId    String
  recipient   Recipient  @relation(fields: [recipientId], references: [id])
  recipientId String
  isSent      Boolean    @default(false)
  amount      Int?
  sentAt      DateTime?

  @@unique([periodId, recipientId])
}

// Browsers/phones that get the daily "reminders due" push (Pengaturan → Reminder alerts).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

enum Repeat {
  NONE
  WEEKLY
  BIWEEKLY // every 14 days, e.g. the cleaning service
  MONTHLY
  YEARLY
}

// Anything to remember that isn't tenant rent (rent reminders come from each tenant's reminder day):
// bills like the cleaning service, repairs, admin. Marking a repeating reminder done moves dueDate on
// by its repeat; with an amount, it also records the expense in that month's cash book.
model Reminder {
  id        String           @id @default(cuid())
  title     String
  tag       String? // Cleaning / Maintenance / Admin / Other (carried over from the old checklist)
  roomId    String? // optional link to a specific room
  dueDate   DateTime? // Jakarta calendar date, stored as UTC midnight
  repeat    Repeat           @default(NONE)
  amount    Int? // Rp; set for bills
  category  ExpenseCategory? // cash book category for the expense a bill records
  isDone    Boolean          @default(false) // one-off reminders only
  doneAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}
